{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Burn Windows",
  "version": "0.6.2",
  "identifier": "dev.scarlabeboy.agent-burn-windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Burn Windows",
        "visible": false,
        "width": 1200,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFQ0MwMkYzRERFMTFBQTIKUldTaUd1SGQ4d0xNVHFmdmwvbmxucVYyZGJpSlhqTUl3K203REZsS3RMclE2R0xTOGJyckkxcjUK",
      "endpoints": ["https://github.com/scarlabeboy/agent-burn-windows-wsl/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/agent-burn"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "scarlabeboy",
    "shortDescription": "Agent Burn for Windows, WSL and combined usage",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["French", "English"]
      }
    }
  }
}
